    {
      "type": "stat",
      "title": "Deployments not fully available",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(kube_deployment_status_replicas_available < kube_deployment_spec_replicas) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
